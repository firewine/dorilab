# RunPod HostName과 외부 SSH 포트는 앱 상단의 "RunPod 연결"에서 저장합니다.
# 아래 값은 이전 .env 방식과 자동화 호환용 fallback이며 보통 입력하지 않습니다.
# RUNPOD_HOST=
# RUNPOD_SSH_PORT=

# 고급 설정은 README_LOCAL_DOCKER.md를 참고하십시오. setup이 기본값과
# 절대 경로를 .env.derived에 기록하므로 보통 아래 값은 필요하지 않습니다.
# DORILAB_SSH_USER=root
# DORILAB_SSH_KEY_PATH=/Users/you/.ssh/id_ed25519
# DORILAB_APP_PORT=8000
# DORILAB_REMOTE_INFERENCE_PORT=8080
# DORILAB_MODEL_PROFILE=dorilab-source-review-v15-rc3
# DORILAB_SSH_USE_AGENT=0
